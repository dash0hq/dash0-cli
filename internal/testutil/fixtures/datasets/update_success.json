{
  "apiVersion": "dash0.com/v1alpha1",
  "kind": "Dash0Dataset",
  "metadata": {
    "name": "Production (renamed)",
    "labels": {
      "dash0.com/id": "production",
      "dash0.com/origin": "dash0-cli",
      "dash0.com/source": "dash0-cli",
      "dash0.com/version": "2"
    },
    "annotations": {
