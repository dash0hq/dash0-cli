{
  "kind": "Dash0SignalToMetrics",
  "metadata": {
    "annotations": {
      "dash0.com/created-at": "2026-10-20T09:14:02.118842Z",
      "dash0.com/updated-at": "2026-10-20T09:14:02.118842Z"
    },
    "labels": {
      "dash0.com/dataset": "default",
      "dash0.com/id": "9f8e7d6c-5b4a-4392-8170-6f5e4d3c2b1a",
      "dash0.com/origin": "api-3e2d1c0b",
      "dash0.com/source": "api",
      "dash0.com/version": "1"
    },
    "name": "checkout-errors"
  },
  "spec": {
    "display": {
      "name": "Checkout error logs"
    },
    "enabled": true,
    "match": {
      "signal": "logs",
      "filters": [
        {
          "key": "service.name",
          "operator": "is",
          "value": "checkout"
        },
        {
          "key": "otel.log.severity.range",
          "operator": "is",
          "value": "ERROR"
        }
      ]
    },
    "output": {
      "name": "checkout.error_logs",
      "description": "Error log records emitted by the checkout service",
      "interval": "1m",
      "keepResourceAttributes": [
        {
          "operator": "is",
          "value": "service.name"
        }
      ]
    }
  }
}
